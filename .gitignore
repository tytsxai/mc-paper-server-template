# Minecraft Server .gitignore
# 排除不需要上传到 Git 的文件

# ============================================
# 本地运行密钥与实例配置
# ============================================
server.properties
server.pid
backup-push.log
.wget-hsts
banned-*.json
ops.json
usercache.json
whitelist.json

# ============================================
# 世界地图文件（不上传）
# ============================================
world/
world_nether/
world_the_end/
QQ群*/
QQ群*_nether/
QQ群*_the_end/
*/region/
*/DIM-1/
*/DIM1/
*/playerdata/
*/stats/
*/advancements/
*/data/

# ============================================
# 旧世界数据备份（不上传）
# ============================================
old-worlds/

# ============================================
# 缓存和临时文件
# ============================================
cache/
*.tmp
*.temp
.console_history

# ============================================
# 版本文件（会自动生成）
# ============================================
version_history.json
paper-*.jar.old
paper-*.jar
versions/
libraries/

# ============================================
# 备份文件
# ============================================
backup-*.tar.gz
*.backup
backups/

# ============================================
# 系统文件
# ============================================
.DS_Store
Thumbs.db
*.swp
*~

# ============================================
# 崩溃报告
# ============================================
crash-reports/

# ============================================
# 日志文件
# ============================================
logs/*.log
logs/*.log.gz
server.log
server_output.log
*.log

# ============================================
# 性能分析文件
# ============================================
spark-*.html
timings-*.txt

# ============================================
# 大型数据库文件（根据需要可以排除）
# ============================================
*.db
*.mv.db
*.bin

# ============================================
# 插件运行时资产与二进制
# ============================================
plugins/*.jar
plugins/*.jar.offline
plugins/.paper-remapped/
plugins/**/userdata/
plugins/**/data/
plugins/**/Logs/
plugins/**/tmp/
plugins/**/libs/
plugins/**/lastupdate
plugins/**/*.bak
plugins/**/*.old
plugins/**/*.new
plugins/**/backup_*
plugins/GriefPreventionData/
plugins/Essentials/usermap.bin
plugins/Essentials/uuids.bin

# ============================================
# 本地世界数据
# ============================================
服务器/
服务器_nether/
服务器_the_end/
