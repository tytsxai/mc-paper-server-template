# Minecraft Server .gitignore
# 排除不需要上传到 Git 的文件

# ============================================
# 日志文件
# ============================================
*.log
*.log.*
logs/
server.log

# ============================================
# 世界数据（太大，不适合上传）
# ============================================
world/
world_nether/
world_the_end/
*/world/
*/world_nether/
*/world_the_end/

# ============================================
# 缓存和临时文件
# ============================================
cache/
.cache/
*.tmp
*.temp
usercache.json
version_history.json

# ============================================
# 玩家数据（包含隐私信息）
# ============================================
banned-ips.json
banned-players.json
ops.json
whitelist.json

# ============================================
# 插件数据（可能包含敏感信息）
# ============================================
plugins/*/playerdata/
plugins/*/players/
plugins/*/userdata/
plugins/AuthMe/authme.db
plugins/AuthMe/backups/
plugins/CoreProtect/database.db
plugins/Essentials/userdata/
plugins/GriefPrevention/ClaimData/
plugins/GriefPrevention/PlayerData/

# ============================================
# 崩溃报告
# ============================================
crash-reports/

# ============================================
# 备份文件
# ============================================
backups/
*.backup
*.bak

# ============================================
# 系统文件
# ============================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============================================
# IDE 文件
# ============================================
.idea/
.vscode/
*.iml

# ============================================
# 保留的文件（注释掉表示要上传）
# ============================================
# 以下文件会被上传：
# - server.properties（服务器配置）
# - bukkit.yml, spigot.yml, paper.yml（服务器配置）
# - plugins/*/config.yml（插件配置）
# - plugins/Essentials/motd.txt（欢迎消息）
# - plugins/Essentials/rules.txt（服务器规则）
# - plugins/Essentials/kits.yml（礼包配置）
# - *.sh（启动脚本）
# - *.md（说明文档）
# - README.md（项目说明）
